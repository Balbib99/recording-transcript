# URL de la API. Con tunel SSH (lo normal) es el puerto local que abre el worker.
RC_API_URL=http://127.0.0.1:8000

# Token de la API: copialo del .env de la Pi
#   ssh pi-rcraft "grep RC_API_TOKEN /srv/recordingcraft/app/server/.env"
RC_API_TOKEN=

# Alias SSH de la Pi (el de ~/.ssh/config). Vacio = no abrir tunel.
RC_SSH_HOST=pi-rcraft
RC_TUNNEL_LOCAL_PORT=8000
RC_TUNNEL_REMOTE=127.0.0.1:8000

# Nombre con el que este worker aparece en la cola.
RC_WORKER_NAME=

# Segundos entre consultas a la cola cuando no hay trabajo.
RC_POLL_SECONDS=15
