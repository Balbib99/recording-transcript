{
  "name": "Reuniones",
  "short_name": "Reuniones",
  "description": "Transcripciones de reuniones con hablantes identificados",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f6f8",
  "theme_color": "#f4f6f8",
  "lang": "es",
  "icons": [
    {
      "src": "iconos/icono-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "iconos/icono-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "iconos/icono-512-recortable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "file",
          "accept": [
            "audio/*",
            "video/mp4",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}
