# Carpeta del host donde se guardan audios, resultados y la base de datos.
# En la Pi: /srv/recordingcraft/data
RC_DATA_HOST=./data

# Token compartido de la API. Generalo con:  openssl rand -hex 32
# Sin el, el servicio se niega a arrancar.
RC_API_TOKEN=

# Limite de subida en megabytes (una hora de grabacion ronda los 30-50 MB).
RC_MAX_UPLOAD_MB=500

# Segundos tras los que un trabajo reclamado y nunca terminado vuelve a la cola.
RC_CLAIM_TIMEOUT=10800
